---
import Layout from "../layouts/Layout.astro";
import TeamCalendarEmbed from "../components/TeamCalendarEmbed.astro";
---

<Layout
  title="Calendar"
  description="Meetings, competitions, outreach, and deadlines for Almont Robotics FRC Team 4961."
>
  <section class="page-header">
    <h1>Team Calendar</h1>
    <p>
      Meetings, competitions, outreach events, and important deadlines.
    </p>
  </section>

  <TeamCalendarEmbed />
</Layout>

<style>
.page-header {
  max-width: 1180px;
  margin: 0 auto;
  padding: 1.2rem 1rem 0.5rem;
}

.page-header h1 {
  margin: 0;
  color: rgba(255,255,255,0.95);
}

.page-header p {
  margin: 0.4rem 0 0;
  color: rgba(255,255,255,0.7);
}
</style>