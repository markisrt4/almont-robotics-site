---
const calendarBase = "https://teamup.com/ksd5jvzz4ymmpkwusk";
const title = "FRC 4961 Team Calendar";

// Clean embedded view: Agenda, minimal chrome
const embedUrl =
  `${calendarBase}` +
  `?view=a` +
  `&showHeader=0` +
  `&showProfileAndInfo=0` +
  `&showSidepanel=0` +
  `&showMenu=0` +
  `&showViewSelector=0` +
  `&showDateControls=1`; // keep date navigation for sanity
---

<section class="cal-wrap">
  <div class="cal-card">
    <div class="cal-header">
      <div>
        <div class="cal-kicker">Almont Robotics</div>
        <h2>{title}</h2>
      </div>

      <a class="cal-btn" href={calendarBase} target="_blank" rel="noreferrer">
        Open full screen
      </a>
    </div>

    <div class="cal-frame">
      <iframe
        src={embedUrl}
        title={title}
        loading="lazy"
        referrerpolicy="no-referrer"
      ></iframe>
    </div>
  </div>
</section>

<style>
.cal-wrap{ max-width:1180px; margin:0 auto; padding: 0.75rem 1rem 1.25rem; }

.cal-card{
  border-radius: 18px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.04);
  box-shadow: 0 18px 48px rgba(0,0,0,.40);
}

.cal-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap: 1rem;
  padding: 1rem 1rem .85rem;
  background: rgba(7,9,7,.72);
  border-bottom: 1px solid rgba(255,255,255,.08);
  backdrop-filter: blur(8px);
}

.cal-kicker{
  font-weight: 800;
  letter-spacing: .2px;
  font-size: .9rem;
  color: rgba(255,255,255,.70);
  margin-bottom: .2rem;
}

.cal-header h2{
  margin: 0;
  font-size: 1.1rem;
  color: rgba(255,255,255,.92);
}

.cal-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding: .55rem .85rem;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.03);
  color: rgba(255,255,255,.92);
  font-weight: 800;
  text-decoration:none;
  transition: transform .15s ease, border-color .15s ease, background .15s ease;
}
.cal-btn:hover{
  transform: translateY(-1px);
  border-color: rgba(245,104,15,.55);
  background: rgba(255,255,255,.06);
}

.cal-frame{
  height: clamp(680px, 80vh, 980px);
  background: rgba(0,0,0,.20);
}
.cal-frame iframe{ width:100%; height:100%; border:0; display:block; }

@media (prefers-reduced-motion: reduce){
  .cal-btn{ transition:none !important; }
}
</style>
