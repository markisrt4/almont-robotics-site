---
const calendarBase = "https://teamup.com/ksd5jvzz4ymmpkwusk";
const icsFeed = "https://ics.teamup.com/feed/ksd5jvzz4ymmpkwusk/0.ics";

// Open full calendar in various views
const fullAgenda = `${calendarBase}?view=a`;
const fullWeek = `${calendarBase}?view=w`;
const fullMonth = `${calendarBase}?view=m`;
const fullList = `${calendarBase}?view=l`;
const fullTiles = `${calendarBase}?view=ti`;
---

<div class="actions-wrap">
  <div class="actions">
    <a class="btn primary" href={calendarBase} target="_blank" rel="noreferrer">
      📅 Open Full Calendar
    </a>

    <div class="views" role="group" aria-label="Open calendar views">
      <a class="chip" href={fullAgenda} target="_blank" rel="noreferrer">Agenda</a>
      <a class="chip" href={fullWeek} target="_blank" rel="noreferrer">Week</a>
      <a class="chip" href={fullMonth} target="_blank" rel="noreferrer">Month</a>
      <a class="chip" href={fullList} target="_blank" rel="noreferrer">List</a>
      <a class="chip" href={fullTiles} target="_blank" rel="noreferrer">Tiles</a>
    </div>

    <details class="dropdown">
      <summary class="btn">
        ⭐ Subscribe
      </summary>
      <div class="menu" role="menu" aria-label="Subscribe options">
        <div class="menu-title">Subscribe by URL (recommended)</div>
        <div class="menu-text">
          Copy this link and add it as a <b>calendar subscription</b> in Google / Apple / Outlook:
        </div>

        <div class="copy-row">
          <input class="copy-input" type="text" readonly value={icsFeed} aria-label="ICS feed URL" />
          <button class="copy-btn" type="button" data-copy="ics">Copy</button>
        </div>

        <div class="divider"></div>

        <div class="menu-title">Quick tips</div>
        <ul class="tips">
          <li><b>Google Calendar</b>: “Other calendars” → “Add by URL”</li>
          <li><b>Apple Calendar</b>: File → New Calendar Subscription</li>
          <li><b>Outlook</b>: Add calendar → Subscribe from web</li>
        </ul>

        <div class="menu-note">
          If you’re not sure, just use <b>Open Full Calendar</b> — it works on any device.
        </div>
      </div>
    </details>
  </div>
</div>

<script>
  (function(){
    const btn = document.querySelector('[data-copy="ics"]');
    const input = document.querySelector('.copy-input');
    if(!btn || !input) return;

    btn.addEventListener('click', async () => {
      try{
        await navigator.clipboard.writeText(input.value);
        const old = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = old), 1200);
      }catch(e){
        // Fallback
        input.select();
        document.execCommand('copy');
        const old = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = old), 1200);
      }
    });
  })();
</script>

<style>
.actions-wrap{
  max-width: 1180px;
  margin: 0 auto;
  padding: 0.5rem 1rem 0;
}

.actions{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:.65rem;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:.65rem .95rem;
  border-radius:14px;
  font-weight:900;
  text-decoration:none;
  border:1px solid rgba(255,255,255,.12);
  background: rgba(255,255,255,.05);
  color: rgba(255,255,255,.95);
  cursor:pointer;
  transition: transform .14s ease, border-color .14s ease, background .14s ease;
}
.btn:hover{
  transform: translateY(-1px);
  background: rgba(255,255,255,.07);
  border-color: rgba(245,104,15,.45);
}

.btn.primary{
  background: linear-gradient(180deg, rgba(245,104,15,.25), rgba(65,154,67,.12));
  border-color: rgba(245,104,15,.55);
}

.views{
  display:flex;
  flex-wrap:wrap;
  gap:.45rem;
  align-items:center;
}

.chip{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:.5rem .7rem;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.04);
  color: rgba(255,255,255,.90);
  font-weight: 800;
  text-decoration:none;
  transition: transform .14s ease, border-color .14s ease, background .14s ease;
}
.chip:hover{
  transform: translateY(-1px);
  background: rgba(255,255,255,.06);
  border-color: rgba(65,154,67,.45);
}

.dropdown{ position:relative; }
.dropdown summary{ list-style:none; }
.dropdown summary::-webkit-details-marker{ display:none; }

.menu{
  position:absolute;
  top: 120%;
  right: 0;
  width: min(520px, calc(100vw - 2rem));
  background: rgba(7,9,7,.96);
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 16px;
  padding: .7rem .75rem;
  box-shadow: 0 18px 48px rgba(0,0,0,.50);
  z-index: 20;
}

.menu-title{
  font-weight: 900;
  color: rgba(255,255,255,.92);
  margin-bottom: .35rem;
}
.menu-text{
  color: rgba(255,255,255,.78);
  line-height: 1.35;
  font-weight: 700;
  font-size: .95rem;
  margin-bottom: .6rem;
}

.copy-row{
  display:flex;
  gap: .5rem;
  align-items:center;
}
.copy-input{
  flex: 1;
  min-width: 180px;
  padding: .6rem .65rem;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.12);
  background: rgba(255,255,255,.06);
  color: rgba(255,255,255,.92);
  font-weight: 800;
  font-size: .9rem;
}
.copy-btn{
  padding: .6rem .75rem;
  border-radius: 12px;
  border: 1px solid rgba(245,104,15,.45);
  background: rgba(245,104,15,.12);
  color: rgba(255,255,255,.94);
  font-weight: 900;
  cursor: pointer;
}
.copy-btn:hover{
  border-color: rgba(65,154,67,.45);
  background: rgba(65,154,67,.12);
}

.divider{
  height: 1px;
  background: rgba(255,255,255,.10);
  margin: .7rem 0;
}

.tips{
  margin: .35rem 0 0 1.1rem;
  padding: 0;
  color: rgba(255,255,255,.78);
  font-weight: 700;
}
.tips li{ margin: .25rem 0; }

.menu-note{
  margin-top: .6rem;
  color: rgba(255,255,255,.70);
  font-weight: 700;
}

@media (prefers-reduced-motion: reduce){
  .btn, .chip{ transition:none !important; }
}
</style>
